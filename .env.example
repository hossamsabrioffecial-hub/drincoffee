# ==========================================================
# DRINCOFFEE — Environment Variables
# Copy this file to .env.local and fill in real values.
# ==========================================================

# ---- Store basics ----
NEXT_PUBLIC_SITE_URL=https://drincoffee.com
NEXT_PUBLIC_WHATSAPP_NUMBER=971XXXXXXXXX

# ---- Admin auth (simple, upgrade to real auth later) ----
# NOTE: this is checked client-side for the localStorage demo, so it must
# be NEXT_PUBLIC_. Replace with real server-side auth (Supabase Auth, etc.)
# before going to production.
ADMIN_EMAIL=admin@drincoffee.com
NEXT_PUBLIC_ADMIN_PASSWORD=drincoffee2024

# ---- Supabase (structure ready, not required for demo) ----
# When you're ready to move off localStorage, create a Supabase
# project and fill these in. lib/data/* is already shaped to match
# Supabase table rows (see lib/types.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Telr (UAE) ----
# Get these from your Telr merchant dashboard.
NEXT_PUBLIC_TELR_STORE_ID=
TELR_AUTH_KEY=
TELR_TEST_MODE=1

# ---- Stripe (international cards) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ---- PayTabs ----
NEXT_PUBLIC_PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_REGION=ARE
